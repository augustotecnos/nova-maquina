#!/usr/bin/env bash
# Ditado por voz offline — pressione o atalho para gravar, pressione de novo para transcrever.
set -uo pipefail

RT="${XDG_RUNTIME_DIR:-/tmp}"
SOCK="$RT/ditado.sock"
PIDF="$RT/ditado.pid"
WAV="$RT/ditado.wav"
export YDOTOOL_SOCKET="${XDG_RUNTIME_DIR:-/tmp}/.ydotool_socket"
TECLAR="$HOME/.local/bin/teclar-portal"
# auto | type | paste | portal | terminal | clipboard
#   auto      com assento usa o ydotool (digita, serve até em terminal);
#             sem assento (acesso remoto) cola pelo portal RemoteDesktop
#   terminal  cola com Ctrl+Shift+V, para terminais
INSERT="${DITADO_INSERT:-auto}"
MAXSEC="${DITADO_MAXSEC:-180}"       # corta sozinho se você esquecer ligado
SOURCE="${DITADO_SOURCE:-}"          # vazio = entrada padrão do sistema

notify() {
  command -v notify-send >/dev/null 2>&1 || return 0
  notify-send -a Ditado -h string:x-canonical-private-synchronous:ditado \
              -t "${3:-3000}" "$1" "${2:-}"
}

wait_server() {
  [[ -S "$SOCK" ]] && return 0
  systemctl --user start ditado.service >/dev/null 2>&1
  for _ in $(seq 1 80); do [[ -S "$SOCK" ]] && return 0; sleep 0.5; done
  return 1
}

ask_server() {
  python3 -c '
import socket, sys
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.settimeout(300); s.connect(sys.argv[1])
s.sendall(sys.argv[2].encode()); s.shutdown(socket.SHUT_WR)
buf = b""
while True:
    c = s.recv(65536)
    if not c: break
    buf += c
sys.stdout.write(buf.decode())' "$SOCK" "$1"
}

inserir() {
  local texto="$1"
  case "$INSERT" in
    clipboard) return 0 ;;
    type)      ydotool type --key-delay 6 -- "$texto" ;;
    paste)     ydotool key 29:1 47:1 47:0 29:0 ;;      # ctrl+v
    portal)    "$TECLAR" colar ;;
    terminal)  "$TECLAR" colar --terminal ;;
    auto|*)
      # Sem assento o ydotool escreve no uinput, o kernel recebe e o Mutter
      # (headless em acesso remoto) não lê ninguém — daí o portal.
      if "$TECLAR" tem-assento 2>/dev/null; then
        ydotool type --key-delay 6 -- "$texto"
      else
        "$TECLAR" colar
      fi ;;
  esac
}

# ---------- já está gravando: parar e transcrever ----------
if [[ -f "$PIDF" ]] && kill -0 "$(cat "$PIDF" 2>/dev/null)" 2>/dev/null; then
  pid="$(cat "$PIDF")"; rm -f "$PIDF"
  kill -INT "$pid" 2>/dev/null
  for _ in $(seq 1 40); do kill -0 "$pid" 2>/dev/null || break; sleep 0.05; done
  kill -KILL "$pid" 2>/dev/null

  [[ -s "$WAV" ]] || { notify "Ditado" "Nada foi gravado."; exit 1; }
  pico="$(python3 -c '
import wave, array, sys
try:
    w = wave.open(sys.argv[1]); d = array.array("h", w.readframes(w.getnframes()))
    print(max((abs(x) for x in d), default=0))
except Exception: print(-1)' "$WAV")"
  if [[ "$pico" == "0" ]]; then
    notify "Microfone mudo" "A gravação veio com sinal zero — verifique a entrada de áudio." 6000
    exit 1
  fi
  notify "Transcrevendo…" "" 2000
  wait_server || { notify "Ditado" "O daemon não subiu."; exit 1; }

  text="$(ask_server "$WAV")"
  [[ -n "$text" ]] || { notify "Ditado" "Não entendi nada."; exit 0; }

  printf '%s' "$text" | wl-copy
  if inserir "$text"; then
    notify "Ditado" "$text" 4000
  else
    notify "Ditado — aperte Ctrl+V" "$text" 6000
  fi
  exit 0
fi

# ---------- não está gravando: começar ----------
rm -f "$WAV"
nohup pw-record ${SOURCE:+--target "$SOURCE"} --rate 16000 --channels 1 --format s16 "$WAV" >/dev/null 2>&1 &
echo $! > "$PIDF"
notify "🎤 Gravando…" "Aperte o atalho de novo para transcrever" 120000
( sleep "$MAXSEC"; [[ -f "$PIDF" ]] && exec "$0" ) >/dev/null 2>&1 &
exit 0
